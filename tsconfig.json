{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "esModuleInterop": true, "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "skipLibCheck": true, "noEmit": true,
    "types": ["node"]
  },
  "include": ["apps", "packages", "scripts", "tests", "vite.config.ts"]
}
